modules = ["web", "java-graalvm22.3"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["unzip", "jdk17"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Build Android"

[[workflows.workflow]]
name = "Build Android"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "./gradlew :app:assembleDebug --no-daemon --stacktrace 2>&1 | head -100"

[userenv]

[userenv.shared]
ANDROID_HOME = "/home/runner/android-sdk"
